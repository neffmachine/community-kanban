# Local-host config. `npm run setup` generates a real .env for you — this file
# just documents the variables. Never commit a real .env (it's gitignored).
HOST_MODE=local
SHOP_NAME=Your Shop
PORT=8080
DB_PATH=./data/shop.db
# The one password everyone at the shop signs in with.
SHOP_PASSWORD=
# Random secret that signs session cookies. `npm run setup` generates one.
SESSION_SECRET=
# Optional: an Anthropic API key enables screenshot-to-item import. Leave blank to skip.
ANTHROPIC_API_KEY=
